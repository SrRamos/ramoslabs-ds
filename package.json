{
  "name": "ramoslabs-ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "description": "RamosLabs Design System monorepo. Tokens are the single source of truth.",
  "license": "MIT",
  "author": "RAMOS SOLUTIONS S.A.S. (https://ramoslabs.com)",
  "homepage": "https://ramoslabs.com",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "turbo run format:check && prettier --check package.json turbo.json tsconfig.base.json vitest.shared.ts vitest.config.ts eslint.config.js .prettierrc.json .stylelintrc.json lefthook.yml .changeset .github/workflows scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "size": "turbo run size",
    "contracts:check": "node scripts/pending-check.mjs contracts:check W1-301 packages/contracts/contracts .contract.json",
    "evidence:check": "node scripts/pending-check.mjs evidence:check W1-317 docs/architecture/evidence/at-support .json",
    "gate": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run size && bun run contracts:check && bun run evidence:check",
    "storybook": "bun run --filter storybook storybook",
    "build-storybook": "bun run --filter storybook build-storybook",
    "changeset": "changeset",
    "prepare": "node scripts/prepare.mjs",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@material-symbols/svg-400": "0.45.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "stylelint": "16.26.1",
    "turbo": "2.10.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
