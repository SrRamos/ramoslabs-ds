{
  "name": "@ramoslabs/css",
  "version": "0.0.0",
  "license": "MIT",
  "author": "RAMOS SOLUTIONS S.A.S. (https://ramoslabs.com)",
  "homepage": "https://ramoslabs.com",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.css": "./dist/*.css",
    ".": "./dist/index.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "new": "node src/_template/generate.mjs"
  },
  "peerDependencies": {
    "@ramoslabs/tokens": ">=0.1.0"
  },
  "devDependencies": {
    "@ramoslabs/testing": "workspace:*",
    "@ramoslabs/tokens": "workspace:*",
    "playwright": "1.64.1",
    "postcss": "8.5.16",
    "vitest": "5.0.5"
  }
}
