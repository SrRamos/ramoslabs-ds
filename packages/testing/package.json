    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
