{
  "name": "@ramoslabs/testing",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "author": "RAMOS SOLUTIONS S.A.S. (https://ramoslabs.com)",
  "homepage": "https://ramoslabs.com",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "size": "node size/cli.js",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/runner/playwright.config.ts",
    "test:e2e:aria": "playwright test -c e2e/aria/playwright.config.ts",
    "test:text-safety": "playwright test -c text-safety/playwright.config.ts",
    "test:visual": "node visual/cli.js check --strict && node visual/cli.js selftest --strict && node visual/cli.js stability",
    "visual:verify": "node visual/cli.js verify",
    "test:a11y": "playwright test -c a11y/playwright.config.ts --grep @pr",
    "test:a11y:release": "playwright test -c a11y/playwright.config.ts",
    "test:e2e:supports": "playwright test -c e2e/supports/playwright.config.ts",
    "parity": "node parity/cli.js",
    "test:coverage": "vitest run --coverage",
    "test:e2e:button": "playwright test -c specs/button/playwright.config.ts",
    "parity:button": "node parity/cli.js --results node_modules/.cache/e2e/button-results.json --expected node_modules/.cache/e2e/button-expected.json --out node_modules/.cache/e2e/parity-button",
    "visual:button": "node specs/button/visual/cli.js check",
    "voiceover:button": "node specs/button/render-voiceover.js",
    "test:e2e:switch": "playwright test -c specs/switch/playwright.config.ts",
    "parity:switch": "node parity/cli.js --results node_modules/.cache/e2e/switch-results.json --expected node_modules/.cache/e2e/switch-expected.json --out node_modules/.cache/e2e/parity-switch",
    "visual:switch": "node specs/switch/visual/cli.js check",
    "voiceover:switch": "node specs/switch/render-voiceover.js",
    "specs:check": "node specs/check.mjs"
  },
  "exports": {
    "./lint": "./lint/index.js",
    "./size": "./size/index.js",
    "./contrast": "./contrast/index.js",
    "./spec": "./spec/index.js",
    "./e2e": "./e2e/index.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@guidepup/guidepup": "0.38.0",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "@ramoslabs/core": "workspace:*",
    "@ramoslabs/react": "workspace:*",
    "@ramoslabs/vanilla": "workspace:*",
    "@ramoslabs/vue": "workspace:*",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue": "3.5.39"
  }
}
