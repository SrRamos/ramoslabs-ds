{
  "name": "@ramoslabs/vue",
  "version": "0.0.0",
  "description": "RamosLabs Vue 3 component library (SJ prefix). Scaffold only in F0.",
  "license": "MIT",
  "author": "RAMOS SOLUTIONS S.A.S. (https://ramoslabs.com)",
  "homepage": "https://ramoslabs.com",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./field": {
      "types": "./dist/field/index.d.ts",
      "import": "./dist/field/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group/index.d.ts",
      "import": "./dist/radio-group/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js"
    },
    "./disclosure": {
      "types": "./dist/disclosure/index.d.ts",
      "import": "./dist/disclosure/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "import": "./dist/popover/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "import": "./dist/tooltip/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@ramoslabs/core": "workspace:*",
    "@ramoslabs/tokens": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "fast-check": "4.10.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
