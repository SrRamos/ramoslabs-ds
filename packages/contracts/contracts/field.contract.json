{
  "$schema": "https://design.ramoslabs.com/schema/contract.v1.json",
  "name": "SJField",
  "contractVersion": "0.1.0",
  "status": "draft",
  "pattern": {
    "apg": "text-field",
    "evidence": "text-field"
  },
  "anatomy": [
    {
      "part": "root",
      "element": "div"
    },
    {
      "part": "label",
      "element": "label"
    },
    {
      "part": "control",
      "element": "input",
      "native": true
    },
    {
      "part": "hint",
      "element": "div"
    },
    {
      "part": "error",
      "element": "div"
    }
  ],
  "state": {
    "machine": ["idle"],
    "controllable": []
  },
  "actions": [],
  "keyboard": {},
  "focus": {
    "strategy": "native",
    "owner": "control"
  },
  "kinds": [],
  "runtime": ["idPrefix"],
  "support": [],
  "a11y": {
    "wcag": ["1.3.1", "1.4.1", "3.3.1", "3.3.2", "3.3.3", "3.3.7", "4.1.2", "4.1.3"],
    "liveRegions": [
      {
        "id": "error",
        "politeness": "polite"
      }
    ],
    "atAssertions": ["manual-field-label-hint-error", "manual-field-error-announced-once"],
    "atSupport": [
      {
        "at": "voiceover",
        "platform": "macos",
        "browser": "safari",
        "test_status": "pending-real-test",
        "evidence": ["at-support/text-field.json#vo-macos-safari-a11ysupport-errormessage"]
      },
      {
        "at": "voiceover",
        "platform": "ios",
        "browser": "safari",
        "test_status": "pending-real-test",
        "evidence": ["at-support/text-field.json#vo-ios-safari-a11ysupport-errormessage"]
      },
      {
        "at": "nvda",
        "platform": "windows",
        "browser": "edge",
        "test_status": "evidence-only",
        "evidence": ["at-support/text-field.json#nvda-edge-a11ysupport-errormessage"]
      },
      {
        "at": "jaws",
        "platform": "windows",
        "browser": "chrome",
        "test_status": "evidence-only",
        "evidence": ["at-support/text-field.json#jaws-chrome-a11ysupport-errormessage"]
      },
      {
        "at": "talkback",
        "platform": "android",
        "browser": "chrome",
        "test_status": "evidence-only",
        "evidence": ["at-support/text-field.json#talkback-chrome-a11ysupport-errormessage"]
      }
    ]
  },
  "events": [],
  "props": [
    {
      "name": "id",
      "type": "string",
      "description": "Explicit control id; the label, hint and error ids are <id>-label, <id>-hint and <id>-error. Otherwise derived from the adapter id source."
    },
    {
      "name": "name",
      "type": "string",
      "description": "Control name; also the key under which the form owner tracks the field and retains its value."
    },
    {
      "name": "required",
      "type": "boolean",
      "default": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    },
    {
      "name": "hasHint",
      "type": "boolean",
      "default": false,
      "description": "A hint is rendered: the control references it through aria-describedby."
    },
    {
      "name": "error",
      "type": "string",
      "description": "Visible error text. Non-empty: aria-invalid=true, the error is referenced through aria-describedby and announced once through the live-region registry. Empty or absent: valid."
    },
    {
      "name": "errorMessage",
      "type": "boolean",
      "default": false,
      "description": "Also emit aria-errormessage on an invalid control. Off by default: aria-describedby is the supported path and aria-errormessage is additive only where its target pair passes (ADR-014)."
    }
  ],
  "slots": [
    {
      "name": "label",
      "description": "Visible label; required."
    },
    {
      "name": "hint",
      "description": "Optional help text."
    },
    {
      "name": "default",
      "description": "The control (SJInput)."
    }
  ],
  "fixtures": ["default", "with-hint", "invalid", "required", "long-label", "disabled"],
  "budgets": {
    "gzipKiB": 3,
    "shared": ["ids", "merge", "kinds", "live"]
  }
}
