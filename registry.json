    "rules": [
      {
        "id": "otp-single-control",
        "text": "OTP is a single text control; split-character inputs are not the default (extra paste, focus, screen-reader and deletion logic)."
      },
      {
        "id": "no-type-number",
        "text": "Numeric-looking identifiers never use type=number (spinbutton and invalid-character problems)."
      },
      {
        "id": "no-maxlength",
        "text": "No maxlength on phone, amount, reference, tax, card or OTP: maxlength truncates pasted text before any input event, so normalize-first becomes impossible. Length is validated after normalization."
      },
      {
        "id": "locale-numbers",
        "text": "Intl formats; an owned deterministic parser reads input, accepting both separators with a grouping-structure rule, no prefill, tested in both directions per locale; never parseFloat, punctuation stripping or binary money arithmetic. The canonical value is separate from editing text."
      },
      {
        "id": "phone-unmasked",
        "text": "Phone is unmasked; live masks require caret-mapping and paste tests."
      },
      {
        "id": "keyboard-locale",
        "text": "Keyboard locale is not application locale."
      },
      {
        "id": "autocorrect-hint",
        "text": "autocorrect is supported from Chromium 153 / Firefox 136 / Safari 14.1 and is treated as a hint."
      },
      {
        "id": "touch-text-size",
        "text": "Touch control text is at least 16 CSS px via size tokens, with maximum-scale and user-scalable prohibited (WCAG 1.4.4)."
      },
      {
        "id": "enterkeyhint",
        "text": "Textarea kinds always use enterkeyhint=enter and are excluded from the position computation. Otherwise the form owner computes it: next when another editable field follows; done on the last field of a non-submitting group; go when Enter navigates or submits; send for messaging; search for query submission. Kind overrides: url go, search search, otp done (auto-submit off) or go (on)."
      },
      {
        "id": "autofill-requirements",
        "text": "Autofill fields need a stable name/id, an owning form and a visible label; address/contact repeats use autofill section tokens."
      },
      {
        "id": "consumer-override",
        "text": "Consumers may override an attribute when the declared data semantics remain true."
      },
      {
        "id": "unknown-kind",
        "text": "An unknown kind is a type error: the kind union is generated from this contract."
      }
    ],
