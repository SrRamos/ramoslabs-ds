            ['--color-info', '#0065a1', 'cerulean 500, hue'],
            ['--color-info-strong', '#00598f', 'cerulean 600, strong'],
            ['--color-info-solid', '#0065a1', 'cerulean 500, solid'],
            ['--color-info-solid-hover', '#00598f', 'cerulean 600, solid hover'],
            ['--color-info-solid-press', '#004b7a', 'cerulean 700, solid press'],
            ['--color-info-on-solid', '#ffffff', 'white, on solid'],
            ['--color-info-surface', '#f0f8ff', 'cerulean 50, surface'],
