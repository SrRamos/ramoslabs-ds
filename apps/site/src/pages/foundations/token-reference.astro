              <td><span class="token-name" data-token={name}>{name}</span></td>
              <td><span class="token-value">{val}</span></td>
              <td><span class="token-description">{role}</span></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </div>

    <div class="token-ref-section" id="breakpoints">
      <h2 class="token-ref-section-title"><Icon name="devices" /> Breakpoints</h2>
      <p class="token-ref-lede">Minimum widths for the responsive scale. See <strong>Foundations / Responsive</strong> for usage.</p>
      <div class="tbl-scroll" tabindex="0" role="region" aria-label="Scrollable table"><table class="token-table">
        <thead><tr><th>Token</th><th>Value</th></tr></thead>
