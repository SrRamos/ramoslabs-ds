            ['--color-success-solid-press', '#005636', 'jade 700, solid press'],
            ['--color-success-on-solid', '#ffffff', 'white, on solid'],
            ['--color-success-surface', '#effaf3', 'jade 50, surface'],
            ['--color-success-surface-hover', '#e1f3e8', 'jade 100, surface hover'],
            ['--color-success-surface-press', '#cce8d7', 'jade 200, surface press'],
            ['--color-success-border', '#cce8d7', 'jade 200, border'],
            ['--color-success-text', '#006641', 'jade 600, text'],
            ['--color-success-text-strong', '#005636', 'jade 700, text strong'],
            ['--color-success-outline', '#3f9a6f', 'jade 400, outline'],
            ['--color-warning', '#f8be52', 'honey 300, hue'],
            ['--color-warning-strong', '#b66c18', 'honey 600, strong'],
            ['--color-warning-solid', '#f8be52', 'honey 300, solid'],
            ['--color-warning-solid-hover', '#efb146', 'honey 400, solid hover'],
            ['--color-warning-solid-press', '#e4a038', 'honey 500, solid press'],
            ['--color-warning-on-solid', '#331d0b', 'honey 950, on solid'],
            ['--color-warning-surface', '#fcf6e9', 'honey 50, surface'],
            ['--color-warning-surface-hover', '#f8edd5', 'honey 100, surface hover'],
            ['--color-warning-surface-press', '#f3ddb3', 'honey 200, surface press'],
            ['--color-warning-border', '#f3ddb3', 'honey 200, border'],
            ['--color-warning-text', '#8d4908', 'honey 700, text'],
            ['--color-warning-text-strong', '#723606', 'honey 800, text strong'],
            ['--color-warning-outline', '#b66c18', 'honey 600, outline'],
            ['--color-error', '#ae212f', 'crimson 500, hue'],
