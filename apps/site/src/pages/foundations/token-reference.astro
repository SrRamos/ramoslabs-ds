  slate: [['50','#f8fafc','#0f172a'],['100','#f1f5f9','#0f172a'],['200','#e2e8f0','#0f172a'],['300','#cbd5e1','#0f172a'],['400','#94a3b8','#0f172a'],['500','#64748b','#ffffff'],['600','#475569','#ffffff'],['700','#334155','#ffffff'],['800','#1e293b','#ffffff'],['900','#0f172a','#ffffff'],['950','#020617','#ffffff']],
  ink: [['50','#f6f6fb','#0f172a'],['100','#ecedf5','#0f172a'],['200','#e1e3ed','#0f172a'],['300','#d1d3e0','#0f172a'],['400','#8e91a2','#0f172a'],['500','#6d7083','#ffffff'],['600','#56596e','#ffffff'],['700','#42465b','#ffffff'],['800','#303448','#ffffff'],['900','#222538','#ffffff'],['950','#151829','#ffffff']],
  jade: [['50','#effaf3','#0f172a'],['100','#e1f3e8','#0f172a'],['200','#cce8d7','#0f172a'],['300','#7ed3a7','#0f172a'],['400','#3f9a6f','#0f172a'],['500','#03734a','#ffffff'],['600','#006641','#ffffff'],['700','#005636','#ffffff'],['800','#1c422f','#ffffff'],['900','#153424','#ffffff'],['950','#0e271b','#ffffff']],
  honey: [['50','#fcf6e9','#0f172a'],['100','#f8edd5','#0f172a'],['200','#f3ddb3','#0f172a'],['300','#f8be52','#0f172a'],['400','#efb146','#0f172a'],['500','#e4a038','#0f172a'],['600','#b66c18','#0f172a'],['700','#8d4908','#ffffff'],['800','#723606','#ffffff'],['900','#442911','#ffffff'],['950','#331d0b','#ffffff']],
  crimson: [['50','#fff4f3','#0f172a'],['100','#ffe7e6','#0f172a'],['200','#ffd4d1','#0f172a'],['300','#ffa09c','#0f172a'],['400','#db5054','#0f172a'],['500','#ae212f','#ffffff'],['600','#9e1326','#ffffff'],['700','#89061d','#ffffff'],['800','#5f2324','#ffffff'],['900','#4b1b1b','#ffffff'],['950','#3b1313','#ffffff']],
  cerulean: [['50','#f0f8ff','#0f172a'],['100','#e0f0ff','#0f172a'],['200','#c9e3fb','#0f172a'],['300','#80c5ff','#0f172a'],['400','#348dcf','#0f172a'],['500','#0065a1','#ffffff'],['600','#00598f','#ffffff'],['700','#004b7a','#ffffff'],['800','#183c59','#ffffff'],['900','#122f46','#ffffff'],['950','#0c2436','#ffffff']],
  violet: [['50','#f5f3ff','#0f172a'],['100','#ede9fe','#0f172a'],['200','#ddd6fe','#0f172a'],['300','#c4b5fd','#0f172a'],['400','#a78bfa','#0f172a'],['500','#8b5cf6','#ffffff'],['600','#7c3aed','#ffffff'],['700','#6d28d9','#ffffff'],['800','#5b21b6','#ffffff'],['900','#4c1d95','#ffffff'],['950','#2e1065','#ffffff']],
